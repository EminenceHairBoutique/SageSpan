# ---------------------------------------------------------------------------
# SageSpan (provisional brand) - local configuration template
# Copy to apps/web/.env.local (web) and export for services/calculator (Python).
# Synthetic data only. Never put real client data or production secrets here.
# ---------------------------------------------------------------------------

# --- Web app (apps/web) -----------------------------------------------------
# Demo mode: file-backed synthetic store, simulated reviewer personas, no login.
# Production is fail-closed (apps/web/src/config/env.ts): with NODE_ENV=production and this
# value not exactly 1, the server refuses the demo defaults and requires CALC_SERVICE_URL plus a
# non-demo CALC_SERVICE_TOKEN, or it fails at start-up. A demo deployment must set it to 1 explicitly.
SAGESPAN_DEMO_MODE=1
# File name of the demo store's JSON state, always kept under apps/web/.demo-state/.
SAGESPAN_DEMO_STATE_PATH=state.json

# Calculation service (server-to-server only; never exposed to the browser).
CALC_SERVICE_URL=http://127.0.0.1:8010
CALC_SERVICE_TOKEN=demo-local-token

# Production auth (optional). When both are set, /app/* resolves the Supabase session
# server-side (auth.getUser), reads the caller's firm memberships and personal /
# household workspaces under RLS, and offers /app/sign-in (password; sign-up is
# disabled in supabase/config.toml). The personal-side Supabase store (DATA-001/002:
# records, snapshots, receipted runs, decisions through app.apply_personal_changes) is
# implemented behind /app/personal; the firm-side store (DATA-003) is not, and /app says so.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role keys must never be present in the browser bundle; they are only
# for server-side maintenance paths and are intentionally not read by the app.

# Brand configuration (provisional; pending trademark clearance).
NEXT_PUBLIC_BRAND_NAME=SageSpan
NEXT_PUBLIC_BRAND_TAGLINE=Independent assurance for every retirement plan

# --- Calculation service (services/calculator) ------------------------------
# Shared secret presented by the web server. CALC_DEMO_MODE=1 substitutes the
# fixed local token "demo-local-token" when CALC_SERVICE_TOKEN is unset.
CALC_DEMO_MODE=1
# CALC_SERVICE_TOKEN=change-me-in-non-demo-environments

# --- V5 AI review layer / AI-CORE-001 runtime / AI-CORE-002a hosted adapter -----
# Provider selection for the bounded tool loop (apps/web/src/ai/provider.ts):
#   (unset) | mock  deterministic two-turn offline mock (default; model -> read-only tool -> model)
#   mock_onepass   the AI-000 one-pass mock, kept for regression comparison (diffReports)
#   hosted         Anthropic Messages API adapter over the LiveProviderPort — SYNTHETIC DEMO DATA ONLY.
#                  Enabled only when ALL of the gates below hold; otherwise the mock runs and every
#                  run's limitations name the missing gate. Real-data processing by any vendor is
#                  release gate G3 (PR-003 + vendor DPA) and is not reachable from configuration.
#   self_hosted    NOT ENABLED: private serving is AI-CORE-005; nothing is benchmarked or gated yet
# Any other value still runs the mock and says so in every run's limitations.
# SAGESPAN_AI_PROVIDER=mock
#
# Hosted gates (server-side only; never in the browser bundle; never commit a real key):
# SAGESPAN_AI_HOSTED_API_KEY=            vendor key
# SAGESPAN_AI_HOSTED_MODEL=              exact model id, pinned by you (no default; e.g. claude-sonnet-5-5 — verify current ids)
# SAGESPAN_AI_HOSTED_SYNTHETIC_ACK=I_UNDERSTAND_SYNTHETIC_ONLY
# (SAGESPAN_DEMO_MODE must be 1)
# Optional ceilings (fail closed to an ERROR run, never a quiet switch to the mock or a cheaper model):
# SAGESPAN_AI_HOSTED_BASE_URL=https://api.anthropic.com
# SAGESPAN_AI_HOSTED_MAX_TOKENS=4096
# SAGESPAN_AI_HOSTED_TIMEOUT_MS=15000
# SAGESPAN_AI_HOSTED_PROCESS_TOKEN_CEILING=250000
# SAGESPAN_AI_HOSTED_RUNS_PER_SCOPE_PER_HOUR=10
# Opt-in live benchmark on the frozen fixtures (spends tokens; writes apps/web/.ai-bench/*.json):
#   with the gates exported, `npx vitest run src/ai/__tests__/ai-hosted.live.test.ts` from apps/web
