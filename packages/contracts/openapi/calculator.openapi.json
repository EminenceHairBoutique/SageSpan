              {
                "enum": [
                  "TRADITIONAL_IRA",
                  "SEP_IRA",
                  "SIMPLE_IRA",
                  "ROTH_IRA",
                  "EMPLOYER_401K",
                  "EMPLOYER_403B",
                  "OTHER"
