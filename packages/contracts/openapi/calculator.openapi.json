  "info": {
    "description": "\nDeterministic, Decimal-safe retirement rule checks with versioned rule sets and\ntraceable receipts. P0 scope: lifetime RMD for living owners of non-inherited\ntraditional-family IRAs using the Uniform Lifetime Table.\n\nTenant context is supplied by the trusted web server via `X-SageSpan-Org-Id`;\nrequest bodies never carry `org_id`. No client data is retained by this service.\n",
    "title": "SageSpan Calculation & Verification Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/checks/rmd": {
      "post": {
        "description": "Independent RMD check for one account and tax year.\n\nReturns PASS with the computed amount and obligation events, or a typed\nNOT_REQUIRED / UNSUPPORTED / INDETERMINATE status with reasons. When an\nimported plan value is supplied, includes a discrepancy classification.",
        "operationId": "check_rmd_v1_checks_rmd_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          },
          {
            "in": "header",
            "name": "X-SageSpan-Org-Id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Sagespan-Org-Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RmdCheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RmdCheckResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing server-resolved tenant header"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid service token"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request did not match the contract (field paths only; submitted values are never echoed)"
          }
        },
        "summary": "Check Rmd",
        "tags": [
          "checks"
        ]
      }
    },
